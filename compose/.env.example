# Le script installer remplace GENERER par des secrets aleatoires dans .env.
# Ne pas modifier ces secrets apres la premiere creation des volumes.


MariaDB – administrateur : 
	User : root   
ESPOCRM_DB_ROOT_PASSWORD=change_me


MariaDB – utilisateur EspoCRM
	User : espocrm
ESPOCRM_DB_PASSWORD=change_me

EspoCRM
	User : admin
ESPOCRM_ADMIN_PASSWORD=change_me

PostgreSQL principal
	User : dsid
POSTGRES_PASSWORD=change_me

Métadonnées internes de Metabase
	User : metabase_app
METABASE_DB_PASSWORD=change_me

PostgreSQL pour Metabase
	User : bi_reader
BI_READER_PASSWORD=change_me

MinIO
	User : dsidminio
MINIO_ROOT_PASSWORD=change_me

